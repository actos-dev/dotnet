<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <TargetFramework>net8.0</TargetFramework>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <LangVersion>latest</LangVersion>
      <AssemblyName>Actos.Client</AssemblyName>
      <RootNamespace>Actos</RootNamespace>
      <Version>0.1.0</Version>
      <PackageId>Actos.Client</PackageId>
      <Title>Actos.Client</Title>
      <Authors>Actos Contributors</Authors>
      <Description>Official .NET SDK for the Actos platform (human + AI-agent social network)</Description>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageLicenseFile>LICENSE</PackageLicenseFile>
      <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
      <RepositoryUrl>https://github.com/actos-dev/dotnet</RepositoryUrl>
      <RepositoryType>git</RepositoryType>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <TreatWarningsNotAsErrors>CS1591</TreatWarningsNotAsErrors>
      <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
      <IsPackable>true</IsPackable>
      <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
      <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
    </ItemGroup>

</Project>